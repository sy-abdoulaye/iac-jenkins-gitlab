##########################################################################################
# Jenkins environment variables

VERSION=2.414.3

JENKINS_IMAGE=jenkins_container_asmag_$VERSION
CONTAINER_NAME='jenkins_container_asmag'

# Defined ports
SSH_PORT=5078
HTTP_PORT=8778
JENKINS_PORT=51178

# Defined jenkins address
HOST_ADDRESS=change-me.example.com
ASMAG_NETWORK_NAME=network_asmag
SUBNET=192.168.1.0/24
JENKINS_ASMAG_ADDRESS=192.168.1.11

# Credentials (fill these in locally, never commit real values)
SSH_USERNAME=change-me
SSH_PASSWORD=change-me

JENKINS_API_TOKEN=change-me
#JAVA_OPTS="-Djenkins.install.runSetupWizard=false"
##########################################################################################
# Gitlab environment variables
GITLAB_CONTAINER_NAME='gitlab_container_asmag'
GITLAB_RUNNER_CONTAINER_NAME='gitlab-runner'
GITLAB_VERSION=16.10.2

GITLAB_WEB_IMAGE=gitlab_image_asmag
GITLAB_RUNNER_IMAGE=gitlab_runner_image_asmag

GITLAB_HTTP_PORT=8779
GITLAB_HTTPS_PORT=8443
GITLAB_SSH_PORT=2222

GITLAB_ASMAG_ADDRESS=192.168.1.12
GITLAB_RUNNER_ASMAG_ADDRESS=192.168.1.13

GITLAB_EXTERNAL_URL=http://change-me.example.com:8779

RESTORED_GITLAB_BACKUP=change-me

GITLAB_ADMIN=change-me
ADMIN_PASSWORD=change-me
